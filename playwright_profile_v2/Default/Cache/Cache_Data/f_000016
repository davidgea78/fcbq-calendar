s Drawn"},pf:{abbr:"FC",abbrEn:"(PF)",label:"Personal Fouls",labelEn:"Personal Fouls"},val:{abbr:"VAL",abbrEn:"(PIR)",label:"Performance Index Rating",labelEn:"Performance Index Rating"},plusMinus:{abbr:"+/−",abbrEn:"(+/−)",label:"Point differential with the player on court",labelEn:"Plus-Minus"},periodBar:{abbr:"P1 · P2 · …",label:"Points scored in that quarter, added up across the whole season"},overtimeBar:{abbr:"PR · PR1 · PR2",label:"Overtime · with a single overtime the bar is PR; with several, the bars are numbered PR1, PR2, … in chronological order"}},formulaGroups:{formulas:"Formulas",siglas:"Abbreviations used in the formulas",pir:"Performance Index Rating (PIR) formula",team:"Team formulas",player:"Player formulas"},formulas:{team:{orbPer:{title:"ORB% — (Offensive Rebound Percentage)",formula:"ORB% = ORB team / (ORB team + DRB rival) × 100",note:"Percentage of the team's offensive rebounds over the total offensive rebounds available."},drbPer:{title:"DRB% — (Defensive Rebound Percentage)",formula:"DRB% = DRB team / (DRB team + ORB rival) × 100",note:"Percentage of the team's defensive rebounds over the total defensive rebounds available."},astToTov:{title:"AST/TO — (Assist to Turnover Ratio)",formula:"AST/TO = AST team / TO team",note:"Simple assists-to-turnovers ratio."},pos:{title:"POS — (Possessions)",formula:"POS = FGA + 0,44 × FTA + TO − ORB",note:"Estimate of the team's possessions. Offensive rebounds do not start a new possession."},pace:{title:"PACE — (Pace)",formula:"PACE = POS × MIN game / MIN team",note:"Game pace: own possessions normalised to the regulation length"},ppp:{title:"PPP — (Points per Possession)",formula:"PPP = PTS / POS",note:"Points per possession. Measures how much each possession yields in scoring terms."},offRating:{title:"OFFRTG — (Offensive Rating)",formula:"OFFRTG = (PTS team / POS team) × 100",note:"Team offensive rating. Points scored by the team per 100 possessions. Higher means better offense."},defRating:{title:"DEFRTG — (Defensive Rating)",formula:"DEFRTG = (PTS rival / POS rival) × 100",note:"Team defensive rating. Points allowed by the team per 100 possessions. Lower means better defense."},netRating:{title:"NETRTG — (Net Rating)",formula:"NETRTG = OFFRTG − DEFRTG",note:"Team net rating. Differential between OFFRTG and DEFRTG."},efgPer:{title:"eFG% — (Effective Field Goal Percentage)",formula:"eFG% = (FGM team + 0,5 × T3M team) / FGA team × 100",note:"Team adjusted shooting efficiency. A 3-pointer weighs 1.5 times a 2-point shot."},tsPer:{title:"TS% — (True Shooting Percentage)",formula:"TS% = PTS team / (2 × (FGA team + 0,44 × FTA team)) × 100",note:"Team true shooting. Real shooting efficiency including free throws."},tovPer:{title:"TO% — (Turnover Percentage)",formula:"TO% = TO team / (FGA team + 0,44 × FTA team + TO team) × 100",note:"Percentage of team possessions ending in a turnover. The lower, the better."},ftr:{title:"FTR — (Free Throw Rate)",formula:"FTR = FTA team / FGA team × 100",note:"Free throws attempted per field goal attempted."}},player:{astToTov:{title:"AST/TO — (Assist to Turnover Ratio)",formula:"AST/TO = AST player / TO player",note:"Assists-to-turnovers ratio of the player"},offRating:{title:"OFFRTG — (Offensive Rating)",formula:"OFFRTG = (PTS team / POS team) × 100",note:"Player offensive rating. Points scored by the team per 100 possessions with the player on court. Higher means better offense."},defRating:{title:"DEFRTG — (Defensive Rating)",formula:"DEFRTG = (PTS rival / POS rival) × 100",note:"Player defensive rating. Points conceded by the team per 100 possessions with the player on court. Lower means better defense."},netRating:{title:"NETRTG — (Net Rating)",formula:"NETRTG = OFFRTG − DEFRTG",note:"Player net rating. Differential between OFFRTG and DEFRTG. It reflects the player's net impact while on court."},astPer:{title:"AST% — (Assist Percentage)",formula:"AST% = AST player / (FGM team − FGM player) × 100",note:"Player assist rate. Percentage of the teammates' baskets that the player assists while on court."},tovPer:{title:"TO% — (Turnover Percentage)",formula:"TO% = TO player / (FGA player + 0,44 × FTA player + TO player) × 100",note:"Percentage of the player's possessions ending in a turnover. The lower, the better."},orbPer:{title:"ORB% — (Offensive Rebound Percentage)",formula:"ORB% = ORB player / (ORB team + DRB rival) × 100",note:"Percentage of the available offensive rebounds the player captures while on court."},drbPer:{title:"DRB% — (Defensive Rebound Percentage)",formula:"DRB% = DRB player / (DRB team + ORB rival) × 100",note:"Percentage of the available defensive rebounds the player captures while on court."},usgPer:{title:"USG% — (Usage Percentage)",formula:"USG% = (FGA + 0,44 × FTA + TO) × MIN team / (MIN player × (FGA team + 0,44 × FTA team + TO team)) × 100",note:"Usage rate. Percentage of team possessions the player finishes (shot, free throw or turnover), adjusted for minutes on court."},pace:{title:"PACE — (Pace)",formula:"PACE = (POS game / 2) × (MIN game / MIN player)",note:"Estimated possessions per full game while the player is on court: the average of the team's own and the opponent's possessions accumulated during the player's minutes, not those of the whole game. In the season view the value is the average of the games weighted by minutes played, not a recomputation over the totals."},stlPer:{title:"STL% — (Steal Percentage)",formula:"STL% = STL player / POS rival × 100",note:"Percentage of opponent possessions ending in a steal by the player while on court."},blkPer:{title:"BLK% — (Block Percentage)",formula:"BLK% = BLK player / (FGA rival − T3A rival) × 100",note:"Percentage of blockable opponent field goals (excluding three-pointers) the player blocks while on court."},tsPer:{title:"TS% — (True Shooting Percentage)",formula:"TS% = PTS / (2 × (FGA + 0,44 × FTA)) × 100",note:"True Shooting. Real shooting efficiency including free throws."},efgPer:{title:"eFG% — (Effective Field Goal Percentage)",formula:"eFG% = (FGM + 0,5 × T3M) / FGA × 100",note:"Adjusted shooting efficiency: a three-pointer counts as 1.5 two-point shots."},ppp:{title:"PPP — (Points per Possession)",formula:"PPP = PTS / (FGA + 0,44 × FTA + TO)",note:"Points per possession finished by the player."},fouls40:{title:"FC and FR per full game",formula:"F per full game = F / MIN × minutes of a full game",note:"Fouls normalised to the regulation length of a full game, which depends on the rule set (40 minutes in FIBA, 48 in MINI and in the NBA), so players with different minute loads can be compared."},frFc:{title:"FR/FC",formula:"FR/FC = FR / FC",note:"Above 1 means the player draws more fouls than the player commits."},ftr:{title:"FTR — (Free Throw Rate)",formula:"FTR = FTA / FGA × 100",note:"How often the player ends up at the free-throw line. Dean Oliver's four factors are a team measure: here the same rate is applied only to the player's own shots."},pppTeamPer100:{title:"PPP per 100 possessions",formula:"PPP × 100 = PTS / player POS × 100",note:"The player's PPP expressed per 100 possessions finished. It is not OFFRTG, which measures the TEAM's points per 100 team possessions while the player is on court."},astRatio:{title:"ASTRAT — (Assist Ratio)",formula:"ASTRAT = 100 × AST / (FGA + 0,44 × FTA + AST + TO)",note:"Percentage of a player's possessions that end in an assist."}},pir:{title:"VAL (PIR) — (Performance Index Rating)",formula:"PIR = PTS + ORB + DRB + AST + STL + BLK + FD − (T2A − T2M) − (T3A − T3M) − (FTA − FTM) − TO − PF",note:"Performance Index Rating. Overall performance index used in the ACB and the EuroLeague. It adds the positive contributions (scoring, rebounds, assists, steals, blocks, fouls drawn) and subtracts the negative ones (missed shots, turnovers, fouls committed)."},posOnCourt:{title:"POS — (Possessions)",formula:"POS = FGA + 0,44 × FTA + TO − ORB (on court)",note:"Estimated team possessions while the player is on court. Offensive rebounds do not