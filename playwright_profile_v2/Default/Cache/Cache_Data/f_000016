:"Faltes rebudes",labelEn:"Fouls Drawn"},pf:{abbr:"FC",abbrEn:"(PF)",label:"Faltes comeses",labelEn:"Personal Fouls"},val:{abbr:"VAL",abbrEn:"(PIR)",label:"Valoració",labelEn:"Performance Index Rating"},plusMinus:{abbr:"+/−",abbrEn:"(+/−)",label:"Diferencial amb el jugador/a en pista",labelEn:"Plus-Minus"},periodBar:{abbr:"P1 · P2 · …",label:"Punts anotats en aquell quart, sumats en tota la temporada"},overtimeBar:{abbr:"PR · PR1 · PR2",label:"Pròrroga · amb una sola pròrroga la barra és PR; amb diverses es numeren PR1, PR2, … en ordre cronològic"}},formulaGroups:{formulas:"Fórmules",siglas:"Sigles usades en les fórmules",pir:"Fórmula de Valoració (PIR)",team:"Fórmules (equip)",player:"Fórmules (jugador/a)"},formulas:{team:{orbPer:{title:"ORB% — (Offensive Rebound Percentage)",formula:"ORB% = ORB team / (ORB team + DRB rival) × 100",note:"Percentatge de rebots ofensius de l'equip sobre el total de rebots ofensius disponibles."},drbPer:{title:"DRB% — (Defensive Rebound Percentage)",formula:"DRB% = DRB team / (DRB team + ORB rival) × 100",note:"Percentatge de rebots defensius de l'equip sobre el total de rebots defensius disponibles."},astToTov:{title:"AST/TO — (Assist to Turnover Ratio)",formula:"AST/TO = AST team / TO team",note:"Ràtio simple d'assistències entre pèrdues."},pos:{title:"POS — (Possessions)",formula:"POS = FGA + 0,44 × FTA + TO − ORB",note:"Estimació de possessions de l'equip. Els rebots ofensius no inicien una nova possessió."},pace:{title:"PACE — (Pace)",formula:"PACE = POS × MIN game / MIN team",note:"Ritme del partit: possessions pròpies normalitzades a la durada reglamentària"},ppp:{title:"PPP — (Points per Possession)",formula:"PPP = PTS / POS",note:"Punts per possessió. Mesura quant rendeix cada possessió en termes anotadors."},offRating:{title:"OFFRTG — (Offensive Rating)",formula:"OFFRTG = (PTS team / POS team) × 100",note:"Rendiment ofensiu de l'equip. Punts anotats per l'equip cada 100 possessions. Com més gran, millor atac."},defRating:{title:"DEFRTG — (Defensive Rating)",formula:"DEFRTG = (PTS rival / POS rival) × 100",note:"Rendiment defensiu de l'equip. Punts encaixats per l'equip cada 100 possessions. Com més petit, millor defensa."},netRating:{title:"NETRTG — (Net Rating)",formula:"NETRTG = OFFRTG − DEFRTG",note:"Rendiment net de l'equip. Diferencial entre OFFRTG i DEFRTG."},efgPer:{title:"eFG% — (Effective Field Goal Percentage)",formula:"eFG% = (FGM team + 0,5 × T3M team) / FGA team × 100",note:"Eficiència de tir ajustada de l'equip. El tir de 3 pesa 1,5 vegades un tir de 2."},tsPer:{title:"TS% — (True Shooting Percentage)",formula:"TS% = PTS team / (2 × (FGA team + 0,44 × FTA team)) × 100",note:"True Shooting de l'equip. Eficiència real de tir incloent-hi els tirs lliures."},tovPer:{title:"TO% — (Turnover Percentage)",formula:"TO% = TO team / (FGA team + 0,44 × FTA team + TO team) × 100",note:"Percentatge de possessions de l'equip acabades en pèrdua. Com més baix, millor."},ftr:{title:"FTR — (Free Throw Rate)",formula:"FTR = FTA team / FGA team × 100",note:"Tirs lliures intentats per cada tir de camp intentat."}},player:{astToTov:{title:"AST/TO — (Assist to Turnover Ratio)",formula:"AST/TO = AST player / TO player",note:"Ràtio d'assistències entre pèrdues del jugador/a"},offRating:{title:"OFFRTG — (Offensive Rating)",formula:"OFFRTG = (PTS team / POS team) × 100",note:"Rendiment ofensiu del jugador/a. Punts anotats per l'equip cada 100 possessions amb el jugador/a a la pista. Com més gran, millor atac."},defRating:{title:"DEFRTG — (Defensive Rating)",formula:"DEFRTG = (PTS rival / POS rival) × 100",note:"Rendiment defensiu del jugador/a. Punts encaixats per l'equip cada 100 possessions amb el jugador/a a la pista. Com més petit, millor defensa."},netRating:{title:"NETRTG — (Net Rating)",formula:"NETRTG = OFFRTG − DEFRTG",note:"Rendiment net del jugador/a. Diferencial entre OFFRTG i DEFRTG. Reflecteix l'impacte net del jugador/a mentre és a la pista."},astPer:{title:"AST% — (Assist Percentage)",formula:"AST% = AST player / (FGM team − FGM player) × 100",note:"Percentatge d'assistències del jugador/a: percentatge de les cistelles dels seus companys que el jugador/a assisteix mentre és a la pista."},tovPer:{title:"TO% — (Turnover Percentage)",formula:"TO% = TO player / (FGA player + 0,44 × FTA player + TO player) × 100",note:"Percentatge de possessions del jugador/a acabades en pèrdua. Com més baix, millor."},orbPer:{title:"ORB% — (Offensive Rebound Percentage)",formula:"ORB% = ORB player / (ORB team + DRB rival) × 100",note:"Percentatge de rebots ofensius disponibles que captura el jugador/a mentre és a la pista."},drbPer:{title:"DRB% — (Defensive Rebound Percentage)",formula:"DRB% = DRB player / (DRB team + ORB rival) × 100",note:"Percentatge de rebots defensius disponibles que captura el jugador/a mentre és a la pista."},usgPer:{title:"USG% — (Usage Percentage)",formula:"USG% = (FGA + 0,44 × FTA + TO) × MIN team / (MIN player × (FGA team + 0,44 × FTA team + TO team)) × 100",note:"Percentatge d'ús: percentatge de possessions de l'equip que acaba el jugador/a (tir, TL o pèrdua), ajustat pels minuts a la pista."},pace:{title:"PACE — (Pace)",formula:"PACE = (POS game / 2) × (MIN game / MIN player)",note:"Ritme del partit: possessions pròpies normalitzades a la durada reglamentària"},stlPer:{title:"STL% — (Steal Percentage)",formula:"STL% = STL player / POS rival × 100",note:"Percentatge de possessions rivals que acaben en recuperació del jugador/a mentre és a la pista."},blkPer:{title:"BLK% — (Block Percentage)",formula:"BLK% = BLK player / (FGA rival − T3A rival) × 100",note:"Percentatge de tirs de camp rivals taponables (excloent-ne els tirs de 3) que tapa el jugador/a a la pista."},tsPer:{title:"TS% — (True Shooting Percentage)",formula:"TS% = PTS / (2 × (FGA + 0,44 × FTA)) × 100",note:"True Shooting del jugador/a. Eficiència real de tir incloent-hi els tirs lliures."},efgPer:{title:"eFG% — (Effective Field Goal Percentage)",formula:"eFG% = (FGM + 0,5 × T3M) / FGA × 100",note:"Eficiència de tir ajustada del jugador/a. El tir de 3 pesa 1,5 vegades un tir de 2."},ppp:{title:"PPP — (Points per Possession)",formula:"PPP = PTS / (FGA + 0,44 × FTA + TO)",note:"Punts per possessió acabada pel jugador/a."},fouls40:{title:"FC i FR per partit complet",formula:"F per partit complet = F / MIN × minuts d'un partit complet",note:"Faltes normalitzades a la durada reglamentària d'un partit complet, que depèn del reglament (40 minuts en FIBA, 48 en MINI i en NBA), per comparar jugadors/es amb minutatges diferents."},frFc:{title:"FR/FC",formula:"FR/FC = FR / FC",note:"Ràtio entre faltes rebudes i comeses"},ftr:{title:"FTR — (Free Throw Rate)",formula:"FTR = FTA / FGA × 100",note:"Freqüència amb què el jugador/a acaba a la línia de tirs lliures. Els quatre factors de Dean Oliver són una mesura d'equip: aquí la mateixa taxa s'aplica només als tirs del jugador/a."},pppTeamPer100:{title:"PPP per 100 possessions",formula:"PPP × 100 = PTS / POS del jugador/a × 100",note:"El PPP del jugador/a expressat per 100 possessions acabades. No és l'OFFRTG, que mesura els punts de l'EQUIP per 100 possessions de l'equip mentre el jugador/a és a la pista."},astRatio:{title:"ASTRAT — (Assist Ratio)",formula:"ASTRAT = 100 × AST / (FGA + 0,44 × FTA + AST + TO)",note:"Percentatge de possessions d'un jugador/a que acaben en assistència."}},pir:{title:"VAL (PIR) — (Performance Index Rating)",formula:"PIR = PTS + ORB + DRB + AST + STL + BLK + FD − (T2A − T2M) − (T3A − T3M) − (FTA − FTM) − TO − PF",note:"Performance Index Rating. Índex de rendiment global usat a l'ACB i l'Eurolliga. Suma les contribucions positives (anotació, rebots, assistències, recuperacions, taps, faltes rebudes) i resta les negatives (errades de tir, pèrdues, faltes comeses)."},posOnCourt:{title:"POS — (Possessions)",formula:"POS = FGA + 0,44 × FTA + TO − ORB (en pista)",note:"Possessions estimades de l'equip mentre el jugador/a és a pista. Els rebots ofensius no inicien una nova possessió, per això es resten."},posRivalOnCourt:{title:"POS — (Possessions)",formula:"POS = FGA + 0,44 × FTA + TO − ORB (en pista)",note:"Possessions estimades del rival mentre el jugador/a és a pista. Els rebots ofensius no inicien una nova possessió, per això es resten."}},tabs:{resumen:"Resum",box:"Estadístiques",pbp:"Jugada a jugada",cara:"Cara a cara",tiros:"Tirs",adv:"Estadística avançada",jugadores:"Jugadors/es",quintetos:"Quintets"},shotTypes:{t1:"Tir lliure",t2:"Tir de 2",t3:"Tir de 3"},lineupBadges:{initial:"Inicial",most:"Més minuts",least:"Menys minuts",best:"Millor",worst:"Pitjor"},stats:{pts:{label:"Punts",abbr:"PTS"},efg:{label:"Percentatge de tir efectiu",abbr:"eFG%"},tovPer:{label:"Percentatge de pèrdues",abbr:"TOV%"},orPer:{label:"Percentatge de rebot ofensiu",abbr:"ORB%"},ftRate:{label:"Taxa de tirs lliures",abbr:"FTr"},offRating:{label:"Rendiment ofensiu",abbr:"OFFRTG"},defRating:{label:"Rendiment defensiu",abbr:"DEFRTG"},netRating:{label:"Rendiment net",abbr:"NETRTG"},pace:{label:"Ritme del partit",abbr:"PACE"},ppp:{label:"Punts per possessió",abbr:"PPP"},possessions:{label:"Possessions",abbr:"POS"},astPer:{label:"Percentatge d'assistències",abbr:"AST%"},drPer:{label:"Percentatge de rebot defensiu",abbr:"DRB%"},defEfg:{label:"Tir efectiu del rival",abbr:"eFG% RIV"},defTovPer:{label:"Percentatge de pèrdues forçades al rival",abbr:"TOV% RIV"},defFtRate:{label:"Taxa de tirs lliures del rival",abbr:"FTr RIV"},tsPer:{label:"Percentatge de tir real",abbr:"TS%"},efgPer:{label:"Percentatge de tir efectiu",abbr:"eFG%"},usgPer:{label:"Percentatge d'ús",abbr:"USG%"},astToTov:{ratioLabel:"Ràtio AST/TO",label:"Assistències per pèrdua",abbr:"AST/TO"},orbPer:{label:"Percentatge de rebot ofensiu",abbr:"ORB%"},drbPer:{label:"Percentatge de rebot defensiu",abbr:"DRB%"},stlPer:{label:"Percentatge de recuperacions",abbr:"ROB%"},blkPer:{label:"Percentatge de taps",abbr:"TAP%"},pir:{label:"Valoració",abbr:"VAL"},eff:{label:"Eficiència",abbr:"EF"},onCourtPlusMinus:{label:"M