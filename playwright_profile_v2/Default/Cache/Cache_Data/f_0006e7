  function applyProfile(name) {
    state.profile = name;
    // Antes de aplicar, volvemos a valores por defecto de las propiedades que tocan los perfiles,
    // para que cambiar de perfil no vaya acumulando ajustes de perfiles anteriores.
    var touched = ['stopAnim', 'saturation', 'brightness', 'invert', 'fontStep', 'contrast', 'cursor',
      'lineHeight', 'dyslexiaFont', 'letterSpacing', 'readingGuide', 'alignLeft', 'focusMode', 'keyboardHelp'];
    touched.forEach(function (k) { state[k] = defaultState[k]; });
    var preset = PROFILE_PRESETS[name] || {};
    Object.keys(preset).forEach(function (k) { state[k] = preset[k]; });
  }

