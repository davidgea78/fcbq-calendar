    var input = document.createElement('input');
    input.type = 'checkbox';
    input.checked = !!state[key];
    input.setAttribute('aria-label', t(labelKey));
    input.addEventListener('change', function () {
      state[key] = input.checked;
      onChange ? onChange(input.checked) : applyState();
      save();
    });
    label.appendChild(input);
    label.appendChild(el('span', 'a11y-switch-track'));
    label.appendChild(el('span', 'a11y-switch-thumb'));
    row.appendChild(span);
    row.appendChild(label);
    return row;
  }

  function sliderBlock(labelKey, key, min, max, step, unit, onChange) {
    var wrap = el('div', 'a11y-slider-block');
