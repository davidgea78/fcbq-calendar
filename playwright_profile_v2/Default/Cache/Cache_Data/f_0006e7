    var name = el('span', null, t(labelKey));
    var val = el('span', 'a11y-val', state[key] + (unit || ''));
    labelRow.appendChild(name);
    labelRow.appendChild(val);
    var input = document.createElement('input');
    input.type = 'range';
    input.min = min; input.max = max; input.step = step; input.value = state[key];
    input.setAttribute('aria-label', t(labelKey));
    input.addEventListener('input', function () {
      state[key] = parseFloat(input.value);
      val.textContent = state[key] + (unit || '');
      onChange ? onChange(state[key]) : applyState();
      save();
    });
    wrap.appendChild(labelRow);
    wrap.appendChild(input);
