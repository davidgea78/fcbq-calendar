      tabBtn.addEventListener('click', function () {
        state.activeTab = tb[0]; save(); renderActiveTab();
      });
      tabsBar.appendChild(tabBtn);
    });
    panel.appendChild(tabsBar);

    panelScroll = el('div', 'a11y-panel-scroll');
    panel.appendChild(panelScroll);

    var footer = el('div', 'a11y-panel-footer', footerHTML());
    panel.appendChild(footer);

    renderActiveTab();
    return panel;
  }

  function rebuildAllTexts() {
    panel.querySelector('#a11y-panel-title') || null;
    panel.querySelector('.a11y-head-row h2').textContent = t('title');
    panel.querySelector('.a11y-close').innerHTML = ICONS.close + '<span class="a11y-sr-only">' + t('closeLabel') + '</span>';
    panel.querySelector('.a11y-reset-top').innerHTML = ICONS.reset + '<span>' + t('resetAll') + '</span>';
    panel.querySelector('.a11y-panel-footer').innerHTML = footerHTML();
    Array.prototype.forEach.call(tabsBar.children, function (tabBtn, i) {
      tabBtn.innerHTML = TABS[i][2] + '<span>' + t(TABS[i][1]) + '</span>';
    });
    btn.setAttribute('aria-label', t('openLabel'));
    renderActiveTab();
  }

  function togglePanel(force) {
    state.panelOpen = typeof force === 'boolean' ? force : !state.panelOpen;
    panel.classList.toggle('a11y-panel-open', state.panelOpen);
    btn.setAttribute('aria-expanded', state.panelOpen ? 'true' : 'false');
    save();
    if (state.panelOpen) {
      var f = panelScroll.querySelector('button, input, select');
      if (f) f.focus();
    }
  }

  function buildButton() {
    btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'a11y-btn';
    btn.setAttribute('aria-haspopup', 'dialog');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', t('openLabel'));
    btn.innerHTML = ICONS.main;
    btn.addEventListener('click', function () { togglePanel(); });
    return btn;
  }

  /* ---------------------------------------------------------------------
   * OVERLAYS: GUÍA DE LECTURA / MODO FOCO
   * ------------------------------------------------------------------- */
  function ensureOverlays() {
    if (!guideTop) {
      guideTop = el('div', 'a11y-overlay'); guideTop.style.top = '0';
      guideBottom = el('div', 'a11y-overlay'); guideBottom.style.bottom = '0';
      focusOverlay = el('div', 'a11y-focus-overlay');
      document.body.appendChild(guideTop);
      document.body.appendChild(guideBottom);
      document.body.appendChild(focusOverlay);
    }
    if (!mouseMoveBound) {
      document.addEventListener('mousemove', onMouseMoveOverlay);
      mouseMoveBound = true;
    }
  }

  function onMouseMoveOverlay(e) {
    if (state.readingGuide) {
      var band = 42;
      guideTop.style.display = 'block';
      guideBottom.style.display = 'block';
      guideTop.style.height = Math.max(0, e.clientY - band) + 'px';
      guideBottom.style.height = Math.max(0, window.innerHeight - e.clientY - band) + 'px';
    } else {
      guideTop.style.display = 'none';
      guideBottom.style.display = 'none';
    }
    if (state.focusMode) {
      focusOverlay.style.display = 'block';
      focusOverlay.style.background =
        'radial-gradient(circle 160px at ' + e.clientX + 'px ' + e.clientY + 'px, transparent 0%, rgba(10,10,15,.75) 160px)';
    } else {
      focusOverlay.style.display = 'none';
    }
  }

  /* ---------------------------------------------------------------------
   * SONIDO Y TTS
   * ------------------------------------------------------------------- */
  function applyMuteSounds() {
    var els = document.querySelectorAll('audio, video');
    els.forEach ? els.forEach(setMute) : Array.prototype.forEach.call(els, setMute);
    function setMute(m) { m.muted = state.muteSounds; if (state.muteSounds) m.pause(); }
  }

  function speakPage() {
    if (!('speechSynthesis' in window)) return;
    var clone = document.body.cloneNode(true);
    var widgetClone = clone.querySelector('.a11y-widget-root');
    if (widgetClone) widgetClone.parentNode.removeChild(widgetClone);
    var text = (clone.innerText || clone.textContent || '').trim().slice(0, 6000);
    if (!text) return;
    window.speechSynthesis.cancel();
    var utter = new SpeechSynthesisUtterance(text);
    utter.lang = SPEECH_LANG[state.lang] || 'es-ES';
    utter.onend = function () { speaking = false; renderActiveTab(); };
    utter.onerror = function () { speaking = false; renderActiveTab(); };
    speaking = true;
    window.speechSynthesis.speak(utter);
  }

  function stopSpeech() {
    if ('speechSynthesis' in window) window.speechSynthesis.cancel();
    speaking = false;
  }

  /* ---------------------------------------------------------------------
   * APLICAR ESTADO
   * ------------------------------------------------------------------- */
  function setClass(elm, cls, on) { elm.classList.toggle(cls, !!on); }

  function applyState() {
    var html = document.documentElement;

    // tamaño de fuente
    html.style.fontSize = 100 + state.fontStep * 10 + '%';

    // espaciados
    injectDynamicVars();

    // fuente / alineación
    setClass(html, 'a11y-dyslexia-font', state.dyslexiaFont);
    setClass(html, 'a11y-align-left', state.alignLeft);

    // contenido
    setClass(html, 'a11y-hide-images', state.hideImages);
    setClass(html, 'a11y-highlight-links', state.highlightLinks);
    setClass(html, 'a11y-highlight-titles', state.highlightTitles);
    setClass(html, 'a11y-stop-anim', state.stopAnim);

    // cursor
    setClass(html, 'a11y-cursor-black', state.cursor === 'black');
    setClass(html, 'a11y-cursor-white', state.cursor === 'white');

    // teclado
    setClass(html, 'a11y-kbnav', state.keyboardHelp);

    // filtros combinados de color
    var filters = [];
    if (state.colorBlind !== 'none') filters.push('url(#a11y-cb-' + state.colorBlind + ')');
    filters.push('contrast(' + state.contrast + '%)');
    filters.push('saturate(' + state.saturation + '%)');
    filters.push('brightness(' + state.brightness + '%)');
    if (state.grayscale) filters.push('grayscale(1)');
    if (state.invert) filters.push('invert(1) hue-rotate(180deg)');
    html.style.filter = filters.join(' ');

    // zoom
    html.style.zoom = state.zoom !== 100 ? state.zoom + '%' : '';

    // colores personalizados
    applyCustomColors();

    // overlays de lectura / foco
    ensureOverlays();
    if (!state.readingGuide) { if (guideTop) { guideTop.style.display = 'none'; guideBottom.style.display = 'none'; } }
    if (!state.focusMode) { if (focusOverlay) focusOverlay.style.display = 'none'; }

    // sonido
    applyMuteSounds();
  }

  var dynamicStyleEl = null;
  function injectDynamicVars() {
    if (!dynamicStyleEl) {
      dynamicStyleEl = document.createElement('style');
      dynamicStyleEl.id = 'a11y-widget-dynamic';
      document.head.appendChild(dynamicStyleEl);
    }
    var ls = state.letterSpacing * 0.05;
    var wsp = state.wordSpacing * 0.12;
    var lh = 1.4 + state.lineHeight * 0.25;
    dynamicStyleEl.textContent =
      'html body, html body *{' +
      (state.letterSpacing ? 'letter-spacing:' + ls + 'em!important;' : '') +
      (state.wordSpacing ? 'word-spacing:' + wsp + 'em!important;' : '') +
      (state.lineHeight ? 'line-height:' + lh + '!important;' : '') +
      '}';
  }

  var customColorStyleEl = null;
  function applyCustomColors() {
    if (!customColorStyleEl) {
      customColorStyleEl = document.createElement('style');
      customColorStyleEl.id = 'a11y-widget-customcolors';
      document.head.appendChild(customColorStyleEl);
    }
    if (!state.customColorsOn) { customColorStyleEl.textContent = ''; return; }
    customColorStyleEl.textContent =
      'html body{background:' + state.bgColor + '!important;}' +
      'html body *:not(.a11y-widget-root):not(.a11y-widget-root *){color:' + state.textColor + '!important;}' +
      'html h1:not(.a11y-widget-root *),html h2:not(.a11y-widget-root *),html h3:not(.a11y-widget-root *),' +
      'html h4:not(.a11y-widget-root *),html h5:not(.a11y-widget-root *),html h6:not(.a11y-widget-root *)' +
      '{color:' + state.titleColor + '!important;}';
  }

  /* ---------------------------------------------------------------------
   * INIT
   * ------------------------------------------------------------------- */
  function init() {
    injectCSS();

    root = el('div', 'a11y-widget-root a11y-pos-' + POSITION);
    root.appendChild(buildButton());
    root.appendChild(buildPanel());
    document.body.appendChild(root);

    injectSvgFilters();

    applyState();
    if (state.panelOpen) togglePanel(true);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && state.panelOpen) { togglePanel(false); btn.focus(); }
    });
    document.addEventListener('click', function (e) {
      if (!state.panelOpen) return;
      if (root.contains(e.target)) return;
      togglePanel(false);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
