        .filter(function (h) { return !root.contains(h) && h.offsetParent !== null; });
    } catch (e) {}
    if (!heads.length) {
      var li = el('li', null, '');
      li.innerHTML = '<span style="display:block;padding:8px 10px;color:#8a8f99;font-size:12px;">' + t('pageStructureEmpty') + '</span>';
      ul.appendChild(li);
      return ul;
    }
    heads.forEach(function (h) {
      var li = document.createElement('li');
      var b = document.createElement('button');
      var level = parseInt(h.tagName.substring(1), 10);
      b.style.paddingLeft = 10 + (level - 1) * 12 + 'px';
      b.textContent = (h.textContent || '').trim().slice(0, 60) || h.tagName;
      b.addEventListener('click', function () {
        h.scrollIntoView({ behavior: 'smooth', block: 'center' });
        h.setAttribute('tabindex', '-1');
        h.focus({ preventScroll: true });
      });
      li.appendChild(b);
      ul.appendChild(li);
    });
    return ul;
  }

